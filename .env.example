# CareerOS runs in DEMO MODE by default — no keys required.
# The deterministic NVIDIA/Ava Chen demo and every page work with nothing set.
HARVEST_ENABLED=
APIFY_TOKEN=
# ── Live mode (optional) ─────────────────────────────────────────────
# Set your Anthropic API key to enable "Run a real job" (/jobs/live), which
# analyzes a real résumé + job posting with Claude. The key is read ONLY on the
# server (Next.js route handlers) and is never sent to the browser.
# Get one at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model used for live analysis (defaults to claude-opus-4-8).
# CAREEROS_MODEL=claude-opus-4-8

# --- Other providers (future phases; not needed for demo or live analysis) ---
# TAVILY_API_KEY=
# GITHUB_TOKEN=
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
